# .env.op — 1Password references for LOCAL tooling, injected via `op run`.
# Usage:  op run --env-file=.env.op -- <command>
# Contains references only (op://…), never secret values — safe to commit.
# Only secrets that (a) exist in the `homelab` vault and (b) are useful to a
# local CLI are kept. In-cluster-only app secrets and non-secrets were dropped
# (they belong in ESO / plain .env, not here). See notes at bottom.

# HuggingFace token
HF_TOKEN=op://env/aizk/HF_TOKEN

# --- LLM API settings ---
# Set default API keys here using nonstandard (underscore-prefixed) variable names
# to prevent unintentional access.
# This requires `os.getenv()`
# _ANTHROPIC_API_KEY=op://env/aizk/ANTHROPIC_API_KEY
# _GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# _GEMINI_API_KEY=""
# _LOCAL_BASE_URL="http://inference.ninerealmlabs.dev:1234/v1"
# _LOCAL_API_KEY="lmstudio"
_OPENROUTER_BASE_URL=op://env/aizk/OPENROUTER_BASE_URL
_OPENROUTER_API_KEY=op://env/aizk/OPENROUTER_API_KEY
# _OPENAI_BASE_URL="https://api.openai.com/v1"
# # _OPENAI_ORG_ID=op://env/aizk/OPENAI_ORG_ID
# _OPENAI_API_KEY=op://env/aizk/OPENAI_API_KEY
# _VOYAGE_API_KEY=op://env/aizk/VOYAGE_API_KEY


# --- KaraKeep ---
# KaraKeep is the authoritative store for raw bookmark content.
# Both variables are required; the service will not start without them.
AIZK_FETCHER__KARAKEEP__BASE_URL=op://env/aizk/KARAKEEP_BASE_URL
AIZK_FETCHER__KARAKEEP__API_KEY=op://env/aizk/KARAKEEP_API_KEY

# --- S3 ---
# S3 bucket used to store conversion artifacts (Markdown, figures, manifest).
AIZK_S3_ENDPOINT_URL=op://env/aizk/S3_ENDPOINT_URL
AIZK_S3_ACCESS_KEY_ID=op://env/aizk/S3_ACCESS_KEY_ID
AIZK_S3_SECRET_ACCESS_KEY=op://env/aizk/S3_SECRET_ACCESS_KEY
# AIZK_S3_BUCKET_NAME="aizk"
# AIZK_S3_REGION="garage"
