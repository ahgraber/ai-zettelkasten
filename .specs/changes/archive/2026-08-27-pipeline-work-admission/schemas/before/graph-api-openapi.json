{
  "openapi": "3.1.0",
  "info": {
    "title": "aizk operator console",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/contextualizations": {
      "get": {
        "tags": ["contextualizations"],
        "summary": "List Jobs",
        "description": "List contextualization work-units, newest first, optionally filtered by status.",
        "operationId": "list_jobs_v1_contextualizations_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/WorkUnitStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextualizationJobList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contextualizations/{job_id}": {
      "get": {
        "tags": ["contextualizations"],
        "summary": "Get Job",
        "description": "Return one contextualization work-unit, or 404 if it does not exist.",
        "operationId": "get_job_v1_contextualizations__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextualizationJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contextualizations/{job_id}/retry": {
      "post": {
        "tags": ["contextualizations"],
        "summary": "Retry Job",
        "description": "Re-queue a terminal work-unit so the worker re-claims it.\n\nRejects (409) a unit that is not in a re-queueable terminal status. Clears the\nerror/retry-wait fields and records a ``requeued`` transition event.",
        "operationId": "retry_job_v1_contextualizations__job_id__retry_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextualizationJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contextualizations/{job_id}/cancel": {
      "post": {
        "tags": ["contextualizations"],
        "summary": "Cancel Job",
        "description": "Cancel a work-unit, writing a terminal ``CANCELLED`` status.\n\nRejects (409) a unit not in a cancellable status. For a running unit this is\ncooperative \u2014 the worker resolves the outcome from its slot state \u2014 but the\noperator-visible status flips immediately.",
        "operationId": "cancel_job_v1_contextualizations__job_id__cancel_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextualizationJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
